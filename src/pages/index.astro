---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import Grove from '../components/Grove.astro';
import { siteConfig, mailLink } from '../config/site';
const { site, business, service } = siteConfig;
---
<BaseLayout title={site.title} description={site.description} isHome>
  <main id="main">
    <section class="hero wrap" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-dot"></span>모바일 앱 스튜디오</p>
        <h1 id="intro-title">아이디어를 키워,<br />일상에 닿는 앱으로<span class="period">.</span></h1>
        <p class="hero-description">{business.brandName}는 모바일 앱을 개발하고 운영하는 스튜디오입니다.<br class="desktop-break" />작은 아이디어에서 출발해, 일상에 필요한 도구를 만듭니다.</p>
        <a class="text-link" href="#service">만들고 있는 서비스<Arrow /></a>
      </div>
      <Grove />
      <div class="hero-bottom"><span>{business.brandName}</span><span>아이디어가 자라는 곳</span></div>
    </section>

    <section class="service-section" id="service" aria-labelledby="service-title">
      <div class="section-grid wrap">
        <div class="section-intro">
          <p class="eyebrow">서비스</p>
          <h2 id="service-title">이미지를 정리하고,<br />대화를 더 가볍게.</h2>
          <p>지금 만들고 있는 모바일 서비스입니다.</p>
        </div>
        <article class="service-card" aria-labelledby="memedraw-title">
          <div class="service-card-top">
            <span class="app-mark" aria-hidden="true">m<span>.</span></span>
            <span class="status"><span class="small-dot"></span>{service.status}</span>
          </div>
          <h3 id="memedraw-title">{service.name}</h3>
          <p class="service-description">{service.description}</p>
          <ul class="service-features">
            <li><span>01</span>검색 태그로 이미지 정리</li>
            <li><span>02</span>커스텀 키보드에서 빠르게 찾기</li>
            <li><span>03</span>대화 속에서 간편하게 공유</li>
          </ul>
          <div class="platforms"><span>{service.platforms.join(' · ')}용 개발 중</span><span class="platform-symbol" aria-hidden="true">↗</span></div>
        </article>
      </div>
    </section>

    <section class="studio-section section-grid wrap" id="studio" aria-labelledby="studio-title">
      <div class="section-intro">
        <p class="eyebrow">스튜디오</p>
        <h2 id="studio-title">아이디어가 모여<br />하나의 수풀처럼.</h2>
        <p>수풀에서 영감을 얻은 이름처럼,<br />다양한 아이디어를 모바일 서비스로 키웁니다.</p>
      </div>
      <div class="business-info">
        <h3>운영 사업자 정보</h3>
        <p class="relationship">{business.relationship}</p>
        <dl>
          <div><dt>상호</dt><dd>{business.registeredName}</dd></div>
          <div><dt>사업자등록번호</dt><dd>{business.registrationNumber}</dd></div>
          <div><dt>문의 이메일</dt><dd><a href={mailLink}>{business.email}</a></dd></div>
        </dl>
      </div>
    </section>

    <section class="contact-section wrap" id="contact" aria-labelledby="contact-title">
      <div class="contact-panel">
        <div>
          <p class="eyebrow">고객지원</p>
          <h2 id="contact-title">궁금한 점이 있으신가요?</h2>
          <p>{service.name} 이용 문의와 오류 제보를 이메일로 보내주세요.</p>
        </div>
        <a class="contact-link" href={mailLink}><span>{business.email}</span><Arrow /></a>
      </div>
    </section>
  </main>
</BaseLayout>
